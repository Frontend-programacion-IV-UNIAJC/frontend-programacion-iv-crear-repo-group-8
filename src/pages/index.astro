---
import Layout from "../layouts/Layout.astro";
import Boton from "../components/ui/Boton.astro";
import CardGrid from "../components/catalogo/CardGrid.astro";
import { obtenerPaises } from "../services/api.js";
//import { paises } from "../data/datos-de-prueba";

const base = import.meta.env.BASE_URL;
const paises = await obtenerPaises();
---

<Layout
  titulo="Destino Abierto — Compara destinos y elige tu próxima aventura"
  descripcion="Compara capital, región, población, idiomas, moneda y husos horarios de dos países, en el mismo orden y sin copiar datos a mano."
  activo="inicio"
  ancho="ancho"
>
  <!-- ============ Portada ============ -->
  <section class="portada">
    <div class="contenedor portada__interior">
      <div class="portada__texto">
        <p class="rotulo">Viajes y Turismo</p>
        <h1>Compara dos destinos en menos de un minuto</h1>
        <p class="portada__entrada">
          Destinos con información clara de países, capitales, idiomas, monedas y horarios. 
          Compara dos opciones lado a lado y elige sin perderte entre pestañas.
        </p>
        <div class="portada__acciones">
          <Boton href={`${base}catalogo`} tamano="grande">Ver el catálogo</Boton>
          <Boton href={`${base}detalle`} variante="secundario" tamano="grande">
            Comparar dos países
          </Boton>
        </div>
        <ul class="portada__datos">
          <li><strong>2</strong> países lado a lado</li>
          <li><strong>8</strong> datos por país</li>
          <li><strong>{paises.length}</strong> países disponibles</li>
        </ul>
      </div>

      <div class="portada__medio">
        <img
          src={`${base}img/destino_abierto_portada.svg`}
          alt="Compara, Planea, Viaja y Disfruta"
          width="640"
          height="480"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ============ Destacadas ============ -->
  <section class="contenedor seccion">
    <div class="seccion__encabezado">
      <div>
        <p class="rotulo">Para empezar</p>
        <h2>Tres destinos para empezar</h2>
      </div>
      <Boton href={`${base}catalogo`} variante="fantasma">Ver todas</Boton>
    </div>
    <CardGrid paises={paises.slice(0, 3)} />
  </section>

  <!-- ============ Como funciona ============ -->
  <section class="contenedor seccion">
    <p class="rotulo">Cómo funciona</p>
    <h2>Tres pasos para decidir</h2>

    <ol class="pasos">
      <li class="paso">
        <span class="paso__numero">1</span>
        <h3>Busca un país</h3>
        <p>Escribe su nombre, o una parte, en el buscador.</p>
      </li>
      <li class="paso">
        <span class="paso__numero">2</span>
        <h3>Elige dos destinos</h3>
        <p>Asigna uno a cada lado de la comparación. Puedes cambiarlos sin empezar de nuevo.</p>
      </li>
      <li class="paso">
        <span class="paso__numero">3</span>
        <h3>Compara fila por fila</h3>
        <p>Los mismos datos en el mismo renglón; las filas distintas quedan marcadas.</p>
      </li>
    </ol>
  </section>
</Layout>

<style>
  /* ---- Portada ---- */

  .portada {
    background: linear-gradient(
      180deg,
      var(--color-marca-suave) 0%,
      var(--color-lienzo) 100%
    );
    border-bottom: 1px solid var(--color-borde);
  }

  .portada__interior {
    display: grid;
    gap: var(--esp-5);
    padding-top: var(--esp-6);
    padding-bottom: var(--esp-6);
    align-items: center;
  }

  @media (min-width: 900px) {
    .portada__interior {
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--esp-6);
      padding-top: var(--esp-7);
      padding-bottom: var(--esp-7);
    }
  }

  .portada__texto h1 {
    max-width: 20ch;
  }

  .portada__entrada {
    font-size: var(--texto-m);
    color: var(--color-texto-suave);
    max-width: 46ch;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
    margin-bottom: var(--esp-5);
  }

  .portada__datos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-4);
    list-style: none;
    margin: 0;
    padding: var(--esp-3) 0 0;
    border-top: 1px solid var(--color-marca-borde);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  .portada__datos strong {
    display: block;
    font-family: var(--fuente);
    font-size: var(--texto-l);
    color: var(--color-texto);
    line-height: 1.2;
  }

  .portada__medio img {
    width: 100%;
    height: auto;
    border-radius: var(--radio-l);
    box-shadow: var(--sombra-3);
  }

  /* ---- Secciones ---- */

  .seccion {
    padding-top: var(--esp-6);
  }

  .seccion__encabezado {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--esp-3);
    margin-bottom: var(--esp-4);
  }

  .seccion__encabezado h2 {
    margin: 0;
  }


  /* ---- Pasos ---- */

  .pasos {
    display: grid;
    gap: var(--esp-4);
    list-style: none;
    margin: var(--esp-4) 0 0;
    padding: 0;
    counter-reset: paso;
  }

  @media (min-width: 768px) {
    .pasos {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .paso {
    background: var(--color-fondo);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m);
    padding: var(--esp-4);
  }

  .paso__numero {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radio-pildora);
    background: var(--color-marca-suave);
    color: var(--color-marca-oscuro);
    font-family: var(--fuente);
    font-weight: 600;
    margin-bottom: var(--esp-3);
  }

  .paso h3 {
    margin-bottom: var(--esp-1);
  }

  .paso p {
    margin: 0;
    color: var(--color-texto-suave);
    font-size: var(--texto-s);
  }
</style>