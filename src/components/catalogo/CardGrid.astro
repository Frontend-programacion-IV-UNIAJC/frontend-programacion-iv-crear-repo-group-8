---
// CardGrid.astro
// Rejilla de tarjetas de paises
import Card from "./Card.astro";
 
const { paises = [] } = Astro.props;
---
 
<ul class="rejilla">
    {paises.map((pais: any) => (
        <li>
            <Card pais={pais} />
        </li>
    ))}
</ul>

<style>
    .rejilla{
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: var(--esp-4);
        list-style: none;
        margin: 0;
        padding: 0;


    }
</style>